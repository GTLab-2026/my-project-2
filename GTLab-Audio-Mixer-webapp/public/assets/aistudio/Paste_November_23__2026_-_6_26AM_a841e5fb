          const oldIndicator = buttons[2].querySelector('.absolute.bottom-1');
          if (oldIndicator) oldIndicator.remove();
          const oldSpinIcon = buttons[2].querySelector('.animate-spin');
          if (oldSpinIcon) oldSpinIcon.classList.remove('animate-spin');

          // Tab 4: MASTER MIX & CONFIG (SET TO ACTIVE)
