<style>
    :root {
      color-scheme: dark;
    }
    body {
      background-color: #0c0e14;
      color: #e1e2eb;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }
    .glass-panel {
      background: linear-gradient(165deg, rgba(29, 31, 38, 0.85) 0%, rgba(12, 14, 20, 0.94) 100%);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(59, 73, 75, 0.5);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(219, 252, 255, 0.08);
    }
    .band-card {
      background: linear-gradient(180deg, rgba(29, 31, 38, 0.72) 0%, rgba(17, 19, 26, 0.94) 100%);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(59, 73, 75, 0.55);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 8px 24px rgba(0, 0, 0, 0.4);
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .band-card:hover {
      border-color: rgba(0, 240, 255, 0.45);
      box-shadow: 0 12px 28px rgba(0, 240, 255, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }
    .band-card.is-bypassed {
      opacity: 0.42;
      filter: grayscale(0.85);
      border-color: rgba(59, 73, 75, 0.3);
    }
    .band-card.is-locked {
      border-style: dashed;
    }
    .band-card.is-solo-active {
      border-color: #00f0ff !important;
      box-shadow: 0 0 20px rgba(0, 240, 255, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }
    /* Rotary Knob */
    .rotary-knob {
      position: relative;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #373940, #11131a 80%);
      border: 1.5px solid #3b494b;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.15);
      cursor: ns-resize;
      user-select: none;
      touch-action: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
      flex-shrink: 0;
    }
    .rotary-knob:hover, .rotary-knob.is-dragging {
      border-color: #00f0ff;
      box-shadow: 0 0 14px rgba(0, 240, 255, 0.4), inset 0 1px 2px rgba(255, 255, 255, 0.25);
    }
    .rotary-knob::after {
      content: '';
      position: absolute;
      top: 5px;
      left: 50%;
      width: 2.5px;
      height: 13px;
      background: #00f0ff;
      border-radius: 2px;
      transform-origin: 50% 18px;
      transform: translateX(-50%) rotate(var(--knob-angle, 0deg));
      box-shadow: 0 0 8px #00f0ff;
    }
    /* Custom vertical slider */
    .v-slider-track {
      position: relative;
      width: 8px;
      background: #0c0e14;
      border: 1px solid #3b494b;
      border-radius: 999px;
      cursor: ns-resize;
      touch-action: none;
    }
    .v-slider-fill {
      position: absolute;
      left: 0;
      right: 0;
      border-radius: 999px;
      pointer-events: none;
    }
    .v-slider-thumb {
      position: absolute;
      left: 50%;
      transform: translate(-50%, 50%);
      width: 18px;
      height: 10px;
      border-radius: 4px;
      background: #00f0ff;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.85);
      border: 1px solid #ffffff;
      cursor: ns-resize;
      touch-action: none;
    }
    /* Custom Horizontal Scrollbar */
    .horizontal-scroll-container::-webkit-scrollbar {
      height: 6px;
    }
    .horizontal-scroll-container::-webkit-scrollbar-track {
      background: #0c0e14;
      border-radius: 4px;
    }
    .horizontal-scroll-container::-webkit-scrollbar-thumb {
      background: #3b494b;
      border-radius: 4px;
    }
    .horizontal-scroll-container::-webkit-scrollbar-thumb:hover {
      background: #00f0ff;
    }
    /* Editable input pill */
    .val-pill {
      cursor: text;
      transition: all 0.15s ease;
    }
    .val-pill:hover {
      border-color: #00f0ff;
      color: #00f0ff;
      background: rgba(0, 240, 255, 0.08);
    }
    /* AI Shimmer Glow */
    @keyframes ai-pulse-glow {
      0%, 100% { box-shadow: 0 0 8px rgba(225, 210, 255, 0.25), inset 0 0 6px rgba(0, 240, 255, 0.15); }
      50% { box-shadow: 0 0 16px rgba(0, 240, 255, 0.45), inset 0 0 10px rgba(225, 210, 255, 0.35); }
    }
    .ai-match-btn:hover {
      animation: ai-pulse-glow 1.5s infinite;
    }
  </style>
</head>
