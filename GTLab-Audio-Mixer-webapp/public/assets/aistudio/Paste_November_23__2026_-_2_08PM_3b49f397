<style>
    :root {
      color-scheme: dark;
    }

    body {
      background-color: #11131a;
      color: #e1e2eb;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
    }

    .glass-panel {
      background: linear-gradient(165deg, rgba(29, 31, 38, 0.78) 0%, rgba(12, 14, 20, 0.9) 100%);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(59, 73, 75, 0.45);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(219, 252, 255, 0.08);
    }

    .glass-strip {
      background: linear-gradient(90deg, rgba(40, 42, 49, 0.55) 0%, rgba(20, 22, 30, 0.88) 100%);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(59, 73, 75, 0.4);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 6px 20px rgba(0, 0, 0, 0.35);
      transition: border-color 0.2s ease, opacity 0.25s ease, background 0.25s ease;
    }

    .glass-strip:hover {
      border-color: rgba(0, 240, 255, 0.3);
    }

    .glass-strip.is-muted {
      border-color: rgba(255, 74, 141, 0.4);
      background: linear-gradient(90deg, rgba(32, 20, 28, 0.6) 0%, rgba(18, 14, 20, 0.88) 100%);
    }

    .eq-canvas-wrap {
      position: relative;
      background: radial-gradient(circle at 50% 0%, rgba(0, 219, 233, 0.08), rgba(12, 14, 20, 0.95) 75%);
      border: 1px solid rgba(59, 73, 75, 0.55);
      box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.75);
      overflow: hidden;
    }

    .eq-canvas-wrap.is-muted canvas {
      opacity: 0.28;
      filter: grayscale(0.7);
      transition: opacity 0.25s ease, filter 0.25s ease;
    }

    .eq-canvas-wrap canvas {
      display: block;
      width: 100%;
      height: 100%;
      transition: opacity 0.25s ease, filter 0.25s ease;
    }

    /* Custom range slider for Pan & Master Volume */
    input[type="range"].pan-slider {
      -webkit-appearance: none;
      appearance: none;
      height: 4px;
      background: #0c0e14;
      border-radius: 999px;
      border: 1px solid #3b494b;
      outline: none;
    }
    input[type="range"].pan-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #00f0ff;
      box-shadow: 0 0 8px rgba(0, 240, 255, 0.8);
      cursor: pointer;
      border: 1px solid #00363a;
    }

    /* Rotary Knob */
    .rotary-knob {
      position: relative;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, #373940, #11131a 75%);
      border: 1.5px solid #3b494b;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.12);
      cursor: ns-resize;
      user-select: none;
      touch-action: none;
      transition: border-color 0.15s ease;
      flex-shrink: 0;
    }
    .rotary-knob:hover, .rotary-knob.is-dragging {
      border-color: #00dbe9;
      box-shadow: 0 0 12px rgba(0, 219, 233, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }
    .rotary-knob::after {
      content: '';
      position: absolute;
      top: 4px;
      left: 50%;
      width: 2px;
      height: 10px;
      background: #00f0ff;
      border-radius: 2px;
      transform-origin: 50% 15px;
      transform: translateX(-50%) rotate(var(--knob-angle, 0deg));
      box-shadow: 0 0 6px #00f0ff;
    }

    /* Vertical Fader */
    input[type="range"].fader-vertical {
      -webkit-appearance: none;
      appearance: none;
      writing-mode: bt-lr; /* IE/Edge */
      -webkit-appearance: slider-vertical;
      width: 24px;
      height: 100px;
      background: transparent;
      outline: none;
      cursor: pointer;
    }

    @keyframes statusBlink {
      0%, 100% { opacity: 1; filter: drop-shadow(0 0 5px #00f0ff); }
      50% { opacity: 0.35; }
    }
    .led-blink-active {
      animation: statusBlink 1.4s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .eq-canvas-wrap canvas,
      .glass-strip,
      .led-blink-active {
        transition: none !important;
        animation: none !important;
      }
    }
  </style>
</head>
