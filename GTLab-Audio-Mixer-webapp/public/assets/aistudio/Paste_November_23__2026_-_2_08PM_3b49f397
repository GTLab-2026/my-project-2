<script>
    (function () {
      const tracks = [
        { id: 1, name: 'Kick Sub-Punch', bpm: '128 BPM', color: '#ff4a8d', muted: false, solo: false, pan: 0,   gain: -1.5, leds: { eq: true,  comp: true,  gate: true,  fx: false }, seed: 0.7 },
        { id: 2, name: 'Snare 808 Crisp', bpm: '128 BPM', color: '#00f0ff', muted: false, solo: false, pan: -8,  gain: -2.0, leds: { eq: true,  comp: true,  gate: false, fx: true  }, seed: 1.9 },
        { id: 3, name: 'Bass Reese Heavy', bpm: '128 BPM', color: '#d0bcff', muted: false, solo: false, pan: 0,   gain: -0.8, leds: { eq: true,  comp: true,  gate: false, fx: true  }, seed: 3.1 },
        { id: 4, name: 'Synth Lead Arp', bpm: '128 BPM', color: '#4ade80', muted: true,  solo: false, pan: 18,  gain: -4.2, leds: { eq: true,  comp: false, gate: false, fx: true  }, seed: 4.4 },
        { id: 5, name: 'Vox Chop Glitch', bpm: '128 BPM', color: '#facc15', muted: false, solo: false, pan: -14, gain: -3.0, leds: { eq: true,  comp: true,  gate: true,  fx: true  }, seed: 5.6 },
        { id: 6, name: 'Atmos Pad Void', bpm: '128 BPM', color: '#38bdf8', muted: false, solo: false, pan: 6,   gain: -5.5, leds: { eq: true,  comp: false, gate: false, fx: true  }, seed: 6.8 }
      ];

      const container = document.getElementById('track-strips-container');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let isPlaying = true;

      // Build Track Strips DOM arranged VERTICALLY as wide horizontal channel cards
      tracks.forEach((track) => {
        const strip = document.createElement('article');
        strip.className = `glass-strip rounded-xl p-3 md:p-3.5 flex flex-col md:flex-row items-stretch md:items-center gap-3.5 ${track.muted ? 'is-muted' : ''}`;
        strip.dataset.trackId = track.id;

        strip.innerHTML = `
          <!-- Section 1: Track ID, Name & BPM -->
          <div class="flex md:flex-col justify-between items-center md:items-start w-full md:w-36 lg:w-40 shrink-0 gap-1 border-b md:border-b-0 md:border-r border-outline-variant/30 pb-2 md:pb-0 md:pr-3">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${track.color}; box-shadow: 0 0 8px ${track.color};"></span>
              <span class="font-mono text-xs font-bold tracking-wide text-primary truncate">CH 0${track.id}</span>
            </div>
            <div class="font-headline text-xs font-semibold text-on-surface truncate max-w-[150px] md:max-w-full" title="${track.name}">${track.name}</div>
            <span class="font-mono text-[10px] text-on-surface-variant">${track.bpm}</span>
          </div>

          <!-- Section 2: Real-time PEQ Waveform Visualizer Canvas (Flexible Width) -->
          <div class="flex-1 min-w-0 flex flex-col justify-center">
            <div class="eq-canvas-wrap rounded-lg h-20 w-full ${track.muted ? 'is-muted' : ''}" data-eq-wrap="${track.id}">
              <canvas data-eq-canvas="${track.id}" aria-label="${track.name} EQ/PEQ Frequency Visualizer"></canvas>
              <div class="absolute top-1 left-2 font-mono text-[9px] text-on-surface-variant/75 pointer-events-none">PEQ-5 // FFT LIVE</div>
              <div class="mute-badge ${track.muted ? '' : 'hidden'} absolute inset-0 flex items-center justify-center pointer-events-none bg-surface/40 backdrop-blur-[2px]">
                <span class="px-2.5 py-0.5 rounded bg-secondary-container/30 border border-secondary-container/70 font-mono text-[10px] font-bold text-secondary tracking-widest shadow-lg">MUTED</span>
              </div>
            </div>
          </div>

          <!-- Section 3: Module Status Buttons (EQ, COMP, GATE, FX with toggleable LED indicators) -->
          <div class="flex md:flex-col lg:flex-row items-center gap-1.5 shrink-0 justify-between md:justify-center">
            ${['eq', 'comp', 'gate', 'fx'].map(mod => `
              <button type="button" data-led="${mod}" class="px-2 py-1 rounded bg-surface-container-lowest border ${track.leds[mod] ? 'border-primary-fixed-dim/50 text-primary-fixed' : 'border-outline-variant/40 text-on-surface-variant/40'} flex items-center gap-1 transition text-[9px] font-mono hover:border-primary-container">
                <span class="w-1.5 h-1.5 rounded-full ${track.leds[mod] ? 'bg-primary-container shadow-[0_0_6px_#00f0ff] led-blink-active' : 'bg-outline-variant'}"></span>
                <span>${mod.toUpperCase()}</span>
              </button>
            `).join('')}
          </div>

          <!-- Section 4: Solo (S) & Mute (M) Buttons -->
          <div class="flex items-center gap-1.5 shrink-0">
            <button type="button" data-action="solo" class="w-8 h-8 rounded-lg font-mono text-xs font-bold border transition flex items-center justify-center ${track.solo ? 'bg-amber-400/25 border-amber-400 text-amber-300 shadow-[0_0_10px_rgba(251,191,36,0.4)]' : 'bg-surface-container-lowest border-outline-variant/60 text-on-surface-variant hover:text-on-surface'}" title="Solo CH 0${track.id}">
              S
            </button>
            <button type="button" data-action="mute" class="w-8 h-8 rounded-lg font-mono text-xs font-bold border transition flex items-center justify-center ${track.muted ? 'bg-secondary-container/25 border-secondary-container text-secondary shadow-[0_0_10px_rgba(255,74,141,0.4)]' : 'bg-surface-container-lowest border-outline-variant/60 text-on-surface-variant hover:text-on-surface'}" title="Mute CH 0${track.id}">
              M
            </button>
          </div>

          <!-- Section 5: Pan Slider (L ← C → R) -->
          <div class="flex flex-col gap-1 w-full md:w-28 shrink-0">
            <div class="flex justify-between font-mono text-[9px] text-on-surface-variant">
              <span>PAN</span>
              <span class="text-primary-fixed font-semibold" data-pan-val>${track.pan === 0 ? 'C' : (track.pan > 0 ? `R${track.pan}` : `L${Math.abs(track.pan)}`)}</span>
            </div>
            <input type="range" min="-50" max="50" value="${track.pan}" class="pan-slider w-full" data-pan-input title="Pan: Left / Right">
          </div>

          <!-- Section 6: Gain Rotary Knob & Editable dB Input -->
          <div class="flex items-center justify-between md:justify-end gap-2.5 w-full md:w-32 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 md:border-l border-outline-variant/30 md:pl-3">
            <div class="rotary-knob" data-knob style="--knob-angle: ${track.gain * 8}deg;" title="Drag vertically to adjust Gain"></div>
            <div class="flex flex-col items-end">
              <span class="font-mono text-[9px] text-on-surface-variant uppercase">GAIN</span>
              <div class="flex items-center gap-1">
                <input type="number" step="0.1" min="-24" max="12" value="${track.gain.toFixed(1)}" data-gain-input class="w-14 bg-surface-container-lowest border border-outline-variant/60 rounded px-1.5 py-0.5 text-right font-mono text-xs text-primary-fixed focus:outline-none focus:border-primary-container shadow-inner">
                <span class="font-mono text-[9px] text-on-surface-variant">dB</span>
              </div>
            </div>
          </div>
        `;

        container.appendChild(strip);

        // Event Listeners for Mute, Solo, Pan, Gain, LEDs
        const muteBtn = strip.querySelector('[data-action="mute"]');
        const soloBtn = strip.querySelector('[data-action="solo"]');
        const eqWrap = strip.querySelector(`[data-eq-wrap="${track.id}"]`);
        const muteBadge = strip.querySelector('.mute-badge');

        muteBtn.addEventListener('click', () => {
          track.muted = !track.muted;
          strip.classList.toggle('is-muted', track.muted);
          eqWrap.classList.toggle('is-muted', track.muted);
          muteBadge.classList.toggle('hidden', !track.muted);
          muteBtn.className = `w-8 h-8 rounded-lg font-mono text-xs font-bold border transition flex items-center justify-center ${track.muted ? 'bg-secondary-container/25 border-secondary-container text-secondary shadow-[0_0_10px_rgba(255,74,141,0.4)]' : 'bg-surface-container-lowest border-outline-variant/60 text-on-surface-variant hover:text-on-surface'}`;
        });

        soloBtn.addEventListener('click', () => {
          track.solo = !track.solo;
          soloBtn.className = `w-8 h-8 rounded-lg font-mono text-xs font-bold border transition flex items-center justify-center ${track.solo ? 'bg-amber-400/25 border-amber-400 text-amber-300 shadow-[0_0_10px_rgba(251,191,36,0.4)]' : 'bg-surface-container-lowest border-outline-variant/60 text-on-surface-variant hover:text-on-surface'}`;
        });

        // Module Toggle Buttons (EQ, COMP, GATE, FX)
        strip.querySelectorAll('[data-led]').forEach((btn) => {
          const mod = btn.dataset.led;
          btn.addEventListener('click', () => {
            track.leds[mod] = !track.leds[mod];
            const dot = btn.querySelector('span:first-child');
            if (track.leds[mod]) {
              btn.className = 'px-2 py-1 rounded bg-surface-container-lowest border border-primary-fixed-dim/50 text-primary-fixed flex items-center gap-1 transition text-[9px] font-mono hover:border-primary-container';
              dot.className = 'w-1.5 h-1.5 rounded-full bg-primary-container shadow-[0_0_6px_#00f0ff] led-blink-active';
            } else {
              btn.className = 'px-2 py-1 rounded bg-surface-container-lowest border border-outline-variant/40 text-on-surface-variant/40 flex items-center gap-1 transition text-[9px] font-mono hover:border-primary-container';
              dot.className = 'w-1.5 h-1.5 rounded-full bg-outline-variant';
            }
          });
        });

        const panInput = strip.querySelector('[data-pan-input]');
        const panVal = strip.querySelector('[data-pan-val]');
        panInput.addEventListener('input', (e) => {
          const v = parseInt(e.target.value, 10);
          track.pan = v;
          panVal.textContent = v === 0 ? 'C' : (v > 0 ? `R${v}` : `L${Math.abs(v)}`);
        });

        const gainInput = strip.querySelector('[data-gain-input]');
        const knob = strip.querySelector('[data-knob]');

        // Update Gain helper function
        function updateGain(val, updateInputField = true) {
          const clamped = Math.max(-24, Math.min(12, Math.round(val * 10) / 10));
          track.gain = clamped;
          knob.style.setProperty('--knob-angle', `${clamped * 8}deg`);
          if (updateInputField && document.activeElement !== gainInput) {
            gainInput.value = clamped.toFixed(1);
          }
        }

        gainInput.addEventListener('input', (e) => {
          const raw = parseFloat(e.target.value);
          if (!isNaN(raw)) {
            updateGain(raw, false);
          }
        });

        gainInput.addEventListener('change', (e) => {
          const raw = parseFloat(e.target.value);
          const safe = isNaN(raw) ? 0 : raw;
          updateGain(safe, true);
        });

        // Interactive Knob Dragging
        let isDraggingKnob = false;
        let startY = 0;
        let startGain = 0;

        knob.addEventListener('pointerdown', (e) => {
          isDraggingKnob = true;
          startY = e.clientY;
          startGain = track.gain;
          knob.classList.add('is-dragging');
          knob.setPointerCapture(e.pointerId);
          e.preventDefault();
        });

        knob.addEventListener('pointermove', (e) => {
          if (!isDraggingKnob) return;
          const deltaY = startY - e.clientY;
          const sensitivity = 0.25;
          const newGain = startGain + deltaY * sensitivity;
          updateGain(newGain, true);
        });

        const endKnobDrag = () => {
          if (isDraggingKnob) {
            isDraggingKnob = false;
            knob.classList.remove('is-dragging');
            gainInput.value = track.gain.toFixed(1);
          }
        };

        knob.addEventListener('pointerup', endKnobDrag);
        knob.addEventListener('pointercancel', endKnobDrag);
      });

      // Canvas Resize Helper
      const canvases = tracks.map(t => {
        const canvas = document.querySelector(`[data-eq-canvas="${t.id}"]`);
        return { track: t, canvas, ctx: canvas.getContext('2d') };
      });

      function resizeCanvases() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvases.forEach(({ canvas }) => {
          const rect = canvas.parentElement.getBoundingClientRect();
          canvas.width = Math.max(1, Math.floor(rect.width * dpr));
          canvas.height = Math.max(1, Math.floor(rect.height * dpr));
        });
      }
      resizeCanvases();
      window.addEventListener('resize', resizeCanvases);

      // Multi-color PEQ Curves + Live FFT Spectrum Renderer with dynamic Gain dB scaling
      function drawTrackEQ(item, timeSec) {
        const { track, canvas, ctx } = item;
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        // Subtle frequency grid
        ctx.strokeStyle = 'rgba(59, 73, 75, 0.35)';
        ctx.lineWidth = 1;
        for (let i = 1; i < 4; i++) {
          const y = (h / 4) * i;
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(w, y);
          ctx.stroke();
        }
        for (let i = 1; i < 7; i++) {
          const x = (w / 7) * i;
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, h);
          ctx.stroke();
        }

        const active = !track.muted && isPlaying;
        const t = prefersReducedMotion ? 0 : timeSec;
        const midY = h * 0.52;

        const gainMultiplier = track.muted ? 0.05 : Math.max(0.12, Math.pow(10, track.gain / 20));
        const amp = active ? gainMultiplier : 0.06;

        // 1. Live FFT Spectrum Bars / Waves
        const bars = 42;
        const barW = w / bars;
        const fftGrad = ctx.createLinearGradient(0, h, 0, 0);
        fftGrad.addColorStop(0, 'rgba(0, 240, 255, 0.04)');
        fftGrad.addColorStop(0.6, 'rgba(0, 219, 233, 0.25)');
        fftGrad.addColorStop(1, 'rgba(255, 74, 141, 0.4)');
        ctx.fillStyle = fftGrad;

        for (let i = 0; i < bars; i++) {
          const norm = i / bars;
          const wave =
            Math.sin(t * 4.2 + i * 0.55 + track.seed) * 0.35 +
            Math.cos(t * 7.1 - i * 0.9 + track.seed * 1.3) * 0.25 +
            0.45;
          const barH = Math.max(2, wave * (1 - norm * 0.3) * h * 0.72 * amp);
          ctx.fillRect(i * barW + 1, h - barH, Math.max(1, barW - 2), barH);
        }

        // 2. Multi-color PEQ Frequency Curves (Heights modulated in real-time by Gain)
        const bands = [
          { color: '#ff5722', center: 0.14, width: 0.10, gain: -0.34, speed: 2.3, phase: 0.0 },
          { color: '#39ff14', center: 0.36, width: 0.11, gain: -0.28, speed: 3.1, phase: 1.2 },
          { color: '#00f0ff', center: 0.55, width: 0.08, gain:  0.26, speed: 2.7, phase: 2.4 },
          { color: '#e040fb', center: 0.73, width: 0.09, gain:  0.22, speed: 3.5, phase: 3.7 },
          { color: '#fef08a', center: 0.89, width: 0.12, gain: -0.24, speed: 1.9, phase: 4.9 }
        ];

        bands.forEach((b) => {
          ctx.beginPath();
          ctx.strokeStyle = b.color;
          ctx.lineWidth = Math.max(1.5, w * 0.0035);
          ctx.shadowColor = b.color;
          ctx.shadowBlur = active ? 7 : 0;

          const dynamicGain = b.gain * (0.75 + 0.35 * Math.sin(t * b.speed + b.phase + track.seed)) * (active ? gainMultiplier : 0.08);

          for (let px = 0; px <= w; px += 3) {
            const xNorm = px / w;
            const dist = (xNorm - b.center) / b.width;
            const bell = Math.exp(-dist * dist * 2.2);
            const y = midY + bell * dynamicGain * h;
            if (px === 0) ctx.moveTo(px, y);
            else ctx.lineTo(px, y);
          }
          ctx.stroke();
          ctx.shadowBlur = 0;
        });
      }

      // Timecode simulation
      let totalFrames = 124 * 60 * 30 + 18 * 30 + 4;
      const timecodeEl = document.getElementById('timecode');

      function updateTimecode() {
        if (!isPlaying) return;
        totalFrames++;
        const hrs = Math.floor(totalFrames / (3600 * 30));
        const remH = totalFrames % (3600 * 30);
        const mins = Math.floor(remH / (60 * 30));
        const remM = remH % (60 * 30);
        const secs = Math.floor(remM / 30);
        const f = remM % 30;
        timecodeEl.textContent = `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}:${String(f).padStart(2, '0')}`;
      }

      function animate(now) {
        const timeSec = now * 0.001;
        canvases.forEach((item) => drawTrackEQ(item, timeSec));

        // Master meter pulse
        if (isPlaying && !prefersReducedMotion) {
          const meter = document.getElementById('master-meter');
          const pct = 62 + Math.sin(timeSec * 5.5) * 18 + Math.cos(timeSec * 9.2) * 8;
          meter.style.width = `${Math.max(15, Math.min(96, pct))}%`;
        }

        if (Math.floor(now / 33) % 2 === 0) {
          updateTimecode();
        }

        if (!prefersReducedMotion) {
          requestAnimationFrame(animate);
        }
      }

      if (prefersReducedMotion) {
        canvases.forEach((item) => drawTrackEQ(item, 0));
      } else {
        requestAnimationFrame(animate);
      }

      // Transport Controls
      const btnPlay = document.getElementById('btn-play');
      const playIcon = document.getElementById('play-icon');
      const btnStop = document.getElementById('btn-stop');
      const btnPrev = document.getElementById('btn-prev');
      const btnNext = document.getElementById('btn-next');

      btnPlay.addEventListener('click', () => {
        isPlaying = !isPlaying;
        playIcon.textContent = isPlaying ? 'pause' : 'play_arrow';
      });

      btnStop.addEventListener('click', () => {
        isPlaying = false;
        playIcon.textContent = 'play_arrow';
      });

      // 20s Skip Markers
      btnPrev.addEventListener('click', () => {
        totalFrames = Math.max(0, totalFrames - 20 * 30);
        updateTimecode();
      });

      btnNext.addEventListener('click', () => {
        totalFrames += 20 * 30;
        updateTimecode();
      });

      // Master Volume Slider
      const masterVolSlider = document.getElementById('master-vol-slider');
      const masterVolLabel = document.getElementById('master-vol-label');
      masterVolSlider.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        const dB = ((val - 82) * 0.35).toFixed(1);
        masterVolLabel.textContent = `${dB > 0 ? '+' : ''}${dB} dB`;
      });

      // AI Filter XY Pad Interaction
      const xyPad = document.getElementById('xy-pad');
      const xyCursor = document.getElementById('xy-cursor');
      const xyXVal = document.getElementById('xy-x-val');
      const xyYVal = document.getElementById('xy-y-val');
      let draggingXY = false;

      function updateXY(clientX, clientY) {
        const rect = xyPad.getBoundingClientRect();
        const x = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
        const y = Math.max(0, Math.min(1, (clientY - rect.top) / rect.height));
        xyCursor.style.left = `${x * 100}%`;
        xyCursor.style.top = `${y * 100}%`;
        const freq = Math.round(80 * Math.pow(250, x));
        xyXVal.textContent = freq >= 1000 ? `${(freq / 1000).toFixed(1)} kHz` : `${freq} Hz`;
        xyYVal.textContent = `${Math.round((1 - y) * 100)}%`;
      }

      xyPad.addEventListener('pointerdown', (e) => {
        draggingXY = true;
        xyPad.setPointerCapture(e.pointerId);
        updateXY(e.clientX, e.clientY);
      });
      xyPad.addEventListener('pointermove', (e) => {
        if (draggingXY) updateXY(e.clientX, e.clientY);
      });
      xyPad.addEventListener('pointerup', () => { draggingXY = false; });
      xyPad.addEventListener('pointercancel', () => { draggingXY = false; });
    })();
  </script>
</body></html>