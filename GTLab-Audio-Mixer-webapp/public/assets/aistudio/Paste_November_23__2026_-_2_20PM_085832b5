<!-- Interactive Scripts for Real-time Channel Strip Controls -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Interactive Solo Toggle Button
    document.querySelectorAll('.solo-toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isSolo = btn.getAttribute('data-solo') === 'true';
        const nextSolo = !isSolo;
        btn.setAttribute('data-solo', nextSolo ? 'true' : 'false');

        const indicator = btn.querySelector('.solo-indicator');
        const text = btn.querySelector('.solo-text');
        const strip = btn.closest('.track-strip');

        if (nextSolo) {
          // Solo Active: Amber/Yellow glow
          btn.className = 'solo-toggle-btn flex items-center gap-1 font-mono text-[11px] px-2.5 py-1 rounded-lg bg-amber-500/20 border border-amber-400/80 shadow-glow-amber text-amber-300 transition shadow-inner group';
          indicator.className = 'solo-indicator w-2 h-2 rounded-full bg-amber-400 shadow-[0_0_8px_#f59e0b] animate-ping transition-all';
          text.className = 'solo-text font-black text-amber-200';
          text.textContent = 'SOLO';
          if (strip) {
            strip.classList.add('shadow-[0_0_20px_rgba(245,158,11,0.25)]');
          }
        } else {
          // Solo Inactive: Dark glass button
          btn.className = 'solo-toggle-btn flex items-center gap-1 font-mono text-[11px] px-2.5 py-1 rounded-lg bg-black/60 border border-slate-700/80 hover:border-amber-400/60 text-slate-400 hover:text-amber-300 transition shadow-inner group';
          indicator.className = 'solo-indicator w-2 h-2 rounded-full bg-slate-600 transition-all';
          text.className = 'solo-text font-bold';
          text.textContent = 'S';
          if (strip) {
            strip.classList.remove('shadow-[0_0_20px_rgba(245,158,11,0.25)]');
          }
        }
      });
    });

    // 2. Interactive Mute Toggle: Red (Muted) vs Green (Unmuted)
    document.querySelectorAll('.mute-toggle-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isMuted = btn.getAttribute('data-muted') === 'true';
        const nextMuted = !isMuted;
        btn.setAttribute('data-muted', nextMuted ? 'true' : 'false');

        const dot = btn.querySelector('.indicator-dot');
        const text = btn.querySelector('.mute-text');

        if (nextMuted) {
          // Mute ON: Glowing Red
          dot.className = 'indicator-dot w-2 h-2 rounded-full bg-rose-500 shadow-[0_0_8px_#ef4444] transition-all';
          text.className = 'mute-text font-bold text-rose-300';
          text.textContent = 'MUTED';
          btn.classList.add('bg-rose-950/40', 'border-rose-500/60', 'shadow-[0_0_12px_rgba(239,68,68,0.3)]');
          btn.classList.remove('bg-black/60', 'border-slate-700/80');
        } else {
          // Mute OFF: Green indicator
          dot.className = 'indicator-dot w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#10b981] transition-all';
          text.className = 'mute-text font-bold text-slate-300';
          text.textContent = 'MUTE';
          btn.classList.remove('bg-rose-950/40', 'border-rose-500/60', 'shadow-[0_0_12px_rgba(239,68,68,0.3)]');
          btn.classList.add('bg-black/60', 'border-slate-700/80');
        }
      });
    });

    // 3. Visual Horizontal Slider Panner Interactive Logic
    document.querySelectorAll('.pan-slider').forEach(slider => {
      const updatePanDisplay = () => {
        const val = parseInt(slider.value, 10);
        const container = slider.closest('.pan-slider-container');
        const display = container.querySelector('.pan-display-val');
        if (!display) return;

        if (val === 0) {
          display.textContent = 'C';
        } else if (val < 0) {
          display.textContent = `L${Math.abs(val)}`;
        } else {
          display.textContent = `R${val}`;
        }
      };

      slider.addEventListener('input', updatePanDisplay);
      slider.addEventListener('change', updatePanDisplay);
    });

    // 4. Precision Rotary Knob Dial (Drag up/down) & Direct dB Text Input Sync
    function syncKnobAndInput(container, gainVal) {
      const min = -12;
      const max = 12;
      const clamped = Math.max(min, Math.min(max, gainVal));

      const dial = container.querySelector('.rotary-dial');
      const input = container.querySelector('.gain-direct-input');
      const pointer = container.querySelector('.knob-pointer');
      const arc = container.querySelector('.knob-arc-active');

      dial.setAttribute('data-gain', clamped.toFixed(1));

      // Calculate rotation: -135deg at min (-12dB) to +135deg at max (+12dB)
      const ratio = (clamped - min) / (max - min); // 0.0 to 1.0
      const deg = (ratio * 270) - 135;
      if (pointer) {
        pointer.style.transform = `rotate(${deg}deg) translateY(-3px)`;
      }

      // Calculate SVG stroke dasharray representation (approx 0 to 72 length)
      const strokeLen = Math.round(ratio * 70);
      if (arc) {
        arc.setAttribute('stroke-dasharray', `${strokeLen}, 100`);
      }

      if (input && document.activeElement !== input) {
        input.value = (clamped > 0 ? '+' : '') + clamped.toFixed(1) + ' dB';
      }
    }

    // Direct text input listener with typing and blur formatting
    document.querySelectorAll('.gain-direct-input').forEach(input => {
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          input.blur();
        }
      });

      input.addEventListener('change', (e) => {
        const parsed = parseFloat(e.target.value.replace(/[^0-9.-]/g, ''));
        const val = isNaN(parsed) ? 0.0 : parsed;
        const container = input.closest('.gain-rotary-container');
        syncKnobAndInput(container, val);
      });

      input.addEventListener('focus', (e) => {
        // Strip dB for easier direct editing
        e.target.value = e.target.value.replace(' dB', '').trim();
      });

      input.addEventListener('blur', (e) => {
        const parsed = parseFloat(e.target.value);
        const val = isNaN(parsed) ? 0.0 : parsed;
        const container = input.closest('.gain-rotary-container');
        syncKnobAndInput(container, val);
      });
    });

    // Rotary Dial Drag Interaction (Click and Drag Up/Down)
    document.querySelectorAll('.rotary-dial').forEach(dial => {
      let isDragging = false;
      let startY = 0;
      let initialGain = 0;

      dial.addEventListener('mousedown', (e) => {
        isDragging = true;
        startY = e.clientY;
        initialGain = parseFloat(dial.getAttribute('data-gain')) || 0;
        document.body.style.cursor = 'ns-resize';
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const deltaY = startY - e.clientY; // positive = dragging up
        const step = 0.15; // sensitivity
        const newGain = initialGain + (deltaY * step);
        const container = dial.closest('.gain-rotary-container');
        syncKnobAndInput(container, newGain);
      });

      window.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          document.body.style.cursor = '';
        }
      });
    });

    // 5. Interactive Module Buttons (EQ/PEQ, Comp/Gate, FX)
    document.querySelectorAll('.module-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isActive = btn.getAttribute('data-active') === 'true';
        const nextActive = !isActive;
        btn.setAttribute('data-active', nextActive ? 'true' : 'false');

        const dot = btn.querySelector('.mod-dot');
        const label = btn.querySelector('.font-bold');
        const valBadge = btn.querySelector('.mod-val');

        if (nextActive) {
          // Active: Blinking Green dot
          if (dot) dot.className = 'mod-dot w-2 h-2 rounded-full bg-emerald-400 animate-blink-green';
          if (label) {
            label.classList.remove('text-slate-400');
            label.classList.add('text-slate-200');
          }
          if (valBadge) {
            valBadge.classList.remove('text-slate-500');
            valBadge.classList.add('text-cyan-300');
            if (valBadge.textContent === 'Off' || valBadge.textContent === 'Bypass') {
              valBadge.textContent = 'Active';
            }
          }
        } else {
          // Inactive: Steady Red dot
          if (dot) dot.className = 'mod-dot w-2 h-2 rounded-full bg-rose-500 shadow-[0_0_3px_#ef4444]';
          if (label) {
            label.classList.remove('text-slate-200');
            label.classList.add('text-slate-400');
          }
          if (valBadge) {
            valBadge.classList.remove('text-cyan-300', 'text-pink-300', 'text-blue-300', 'text-purple-300', 'text-amber-300', 'text-lime-300');
            valBadge.classList.add('text-slate-500');
            valBadge.textContent = 'Bypass';
          }
        }
      });
    });
  });
</script>
